# Shopify Partners app credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,write_discounts,write_checkouts
# App URL (the Shopify CLI sets this automatically during `shopify app dev`).
# Do not use HOST for this — react-router-serve treats HOST as the bind address.
SHOPIFY_APP_URL=

# Where the AVA Pay /verify endpoint is reachable from this app.
# In dev, point this at the API server you scaffolded earlier.
AVA_PAY_API_URL=http://localhost:3000

# Postgres in every environment. Locally: see "Local database" in README.md
# (brew install postgresql@17, then create the ava_pay role and database).
# In production this comes from the Railway Postgres plugin.
DATABASE_URL=postgresql://ava_pay:ava_pay@localhost:5432/ava_pay_shopify

PORT=3001
